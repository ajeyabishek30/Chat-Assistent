rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Chats collection - users can manage their own chats
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // For anonymous users, allow temporary storage (you can adjust this based on your needs)
    match /anonymous_chats/{sessionId} {
      allow read, write: if true; // Allow all for now - you may want to add security
    }
  }
}
